% Para matematicas
% Clásicos y Semíticos
\newcommand{\mgreek}[1]{\text{\textgreek{#1}}}
\newcommand{\marabic}[1]{\text{\textarabic{#1}}}
\newcommand{\mhebrew}[1]{\text{\texthebrew{#1}}}

% Indostánicos y Sudeste Asiático
\newcommand{\mhindi}[1]{\text{\texthindi{#1}}}
\newcommand{\msanskrit}[1]{\text{\textsanskrit{#1}}}
\newcommand{\mthai}[1]{\text{\textthai{#1}}}

% CJK (Asia Oriental)
\newcommand{\mchinese}[1]{\text{\textchinese{#1}}}
\newcommand{\mjapanese}[1]{\text{\textjapanese{#1}}}
\newcommand{\mkorean}[1]{\text{\textkorean{#1}}}

% Cáucaso y Antiguos
\newcommand{\mgeorgian}[1]{\text{\textgeorgian{#1}}}
\newcommand{\marmenian}[1]{\text{\textarmenian{#1}}}
\newcommand{\mcoptic}[1]{\text{\textcoptic{#1}}}

