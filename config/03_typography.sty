\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{config/03_typography}[Fuentes, Polyglossia y formato de texto]

% Carga del motor tipográfico
\RequirePackage{fontspec}

%====================================================%

% UN DIA VA PETAR PER LA CACHÉ, QUE ESTA EN C:\texlive\2024\texmf-var\luatex-cache\
% Es bo eliminarla si peta o s'esta debuguejant
% També sé que no peta si treus els [Path] i poses les fonts en ./ (al mateix lloc que main.tex)

%====================================================%

\newcommand{\fsize}[1]{\fontsize{#1}{#1}\selectfont}

%====================================================%

% Fuente principal (Computer Modern Unicode)
\setmainfont{cmun}[
Extension      = .otf,
UprightFont    = *rm,
BoldFont       = *bx,
ItalicFont     = *ti,
BoldItalicFont = *bi,
SlantedFont    = *sl,
Ligatures      = {NoCommon},
]

%====================================================%

\newfontfamily\cmrbbfam[Path = ./fonts/, Extension = .ttf, NFSSFamily = cmrbb]{cmrbb}

\DeclareMathAlphabet{\cmrbb}{TU}{cmrbb}{m}{n}

%====================================================%

\newfontfamily\monocraft[Path = ./fonts/, Extension = .ttf, NFSSFamily = mc]{monocraft}

\newcommand{\textmc}[1]{{\fsize{9pt}\monocraft{#1}}}
\newcommand{\titlemc}[1]{{\monocraft{#1}}}

%====================================================%

\setmonofont[Path = ./fonts/, Extension = .ttf, Contextuals=Alternate]{FiraCode-Regular}

\let\oldtexttt\texttt
\renewcommand{\texttt}[1]{{\fsize{10pt}{\oldtexttt{#1}}}}
\newcommand{\titlett}[1]{\oldtexttt{#1}}

%====================================================%

% Font per tots els unicode, especialment per imprimir caracters com Ϝ ϝ Ͷ ͷ Ͱ ͱ Ϻ ϻ Ϙ ϙ Ϟ ϟ Ͳ ͳ Ϡ ϡ Ϸ ϸ Ϛ ϛ
\newfontfamily\notofont{Noto Serif}
\newcommand{\textnoto}[1]{{\notofont #1}}

\newfontfamily\freefont{FreeSerif}
\newcommand{\textfree}[1]{{\freefont #1}}

\newfontfamily\gentiumfont{Gentium Plus}
\newcommand{\textgentium}[1]{{\gentiumfont #1}}

\newfontfamily\dejavufont{DejaVu Serif}
\newcommand{\textdejavu}[1]{{\dejavufont #1}}

\newfontfamily\libertfont{Libertinus Serif}
\newcommand{\textlibert}[1]{{\libertfont #1}}

\newfontfamily\junifont{Junicode}
\newcommand{\textjuni}[1]{{\junifont #1}}

\newfontfamily\stixfont{STIX Two Text}
\newcommand{\textstix}[1]{{\stixfont #1}}

\newfontfamily\gfsdidotfont{GFS Didot}
\newcommand{\textgfsdidot}[1]{{\gfsdidotfont #1}}

%====================================================%

% Idiomas y fuentes multilingües (Polyglossia)
\RequirePackage{polyglossia}

\newfontfamily\hebrewfont[Script=Hebrew]{Hadasim CLM}
