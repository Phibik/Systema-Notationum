% Tally Marks (Marcas de recuento con literales PDF)
\newcount\tmpnum
\def\tallymarks#1{\leavevmode\lower1bp\vbox to9bp{}\tmpnum=#1\loop\ifnum\tmpnum<5\kern1bp\tallynum\tmpnum\else\tallyV\fi\advance\tmpnum by-5\ifnum\tmpnum>0\repeat}
\def\tallynum#1{\bgroup\tmpnum=#1\relax\loop\ifnum\tmpnum>0\kern1bp\tallyI\kern1bp\advance\tmpnum by-1\repeat\egroup}
\def\tallyI{\pdfliteral{q .5 w 0 -1 m 0 8 l S Q}}
\def\tallyV{\kern1bp\pdfliteral{q .5 w -1 0 m 9 7 l S Q}\tallynum4\kern1bp}

