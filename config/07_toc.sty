% Comportamiento de Partes y minitoc en la ToC
\makeatletter
\def\@endpart{
	\vfil
	\textcolor{text_base_color}{Chapters \hrule height 1.5 pt}
	\setcounter{tocdepth}{1}
	\startcontents[parts]
	\printcontents[parts]{}{0}{}
	\textcolor{text_base_color}{\hrule height 1.5 pt}
	\par\bigskip
	\vfil\newpage
	\if@twoside
	\if@openright
	\null
	\thispagestyle{empty}%
	\newpage
	\fi
	\fi
	\if@tempswa
	\twocolumn
	\fi
}

% Formato visual del elemento Part en la ToC
\renewcommand{\l@part}[2]{%
	\ifnum \c@tocdepth >-2
	\addpenalty{-\@highpenalty}%
	\vskip 2em
	{\noindent\bfseries\scshape\large #1\hfill #2}\par
	\fi
}
\makeatother