\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{config/08_header_footnote}[Cabeceras, pies de página y notas al pie]

\RequirePackage{config/01_colors}
\RequirePackage{config/02_basics}
\RequirePackage{config/06_tikz}

\RequirePackage[hang, flushmargin, bottom]{footmisc}
\RequirePackage{fancyhdr}

%====================================================%

% cabeceras y estilo de página
\pagestyle{fancy}
\renewcommand{\chaptermark}[1]{\markboth{#1}{#1}}
\fancyhead[C]{}
\fancyhead[L]{\textsc{\titleheader}}
\setlength{\headheight}{15pt}

%====================================================%

% configuración de notas al pie (tema)
\ifdefstring{\docstyle}{dark}{\newcommand{\footnoteColorConfig}{C3}}{}
\ifdefstring{\docstyle}{formal}{\newcommand{\footnoteColorConfig}{black}}{}

% configuración de notas al pie
\renewcommand{\thefootnote}{\color{\footnoteColorConfig}[\arabic{footnote}]}
\let\oldfootnote\footnote
\renewcommand{\footnote}[1]{\oldfootnote{\;#1}}						% \footnote{text}: numerada automaticamente
\newcommand\varfootnote[1]{%										% \varfootnote{text}: no numerada, util con $\dagger$ o * para hacer notación agrupadas en varios terminos
	\bgroup\renewcommand\thefootnote{\fnsymbol{footnote}}%
	\renewcommand\thempfootnote{\fnsymbol{mpfootnote}}%
	\footnotetext[0]{#1}\egroup%
}

%====================================================%

