% Chapter formal theme
\ifdefstring{\docstyle}{formal}
{

}

%====================================================%

\titleformat{\part}[block]
{\normalfont}{}{0.75em}{\parttitle{east}{west}{0\paperwidth}{#1}}

\titleformat{\chapter}[block]
{\normalfont}{}{0.75em}{\chaptertitle{east}{west}{0\paperwidth}{#1}}

\titleformat{name=\chapter,numberless}[block]
{\normalfont}{}{0em}{\chapterlesstitle{east}{west}{0\paperwidth}{#1}}[]

% chapter spacing
\titlespacing*{name=\chapter,numberless}{0pt}{-130pt}{-15pt} 
\titlespacing*{\chapter}{0pt}{-130pt}{-15pt}

%====================================================%

\ifdefstring{\docstyle}{dark}
{
	\titleformat{\section}[block]
	{\normalfont\Large\bfseries}{\color{R4}\thesection}{0.75em}{\color{R4}\Large #1}
	
	\titleformat{\subsection}[block]
	{\normalfont\large\bfseries}{\color{R3}\thesubsection}{0.75em}{\color{R3}\large #1}
	
	\titleformat{\subsubsection}[block]
	{\normalfont\bfseries}{}{0.75em}{\color{R2}#1}
	
	\titleformat{name=\section,numberless}[block]
	{\color{R4}\normalfont\Large\bfseries}{}{0em}{#1}
	
	\titleformat{name=\subsection,numberless}[block]
	{\color{R3}\normalfont\large\bfseries}{}{0em}{#1}
}{}
\ifdefstring{\docstyle}{formal}
{

}{}

