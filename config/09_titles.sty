% Part
\newcommand{\parttitle}[4]{%
	\begin{center}%
		\fsize{40}\textbf{\thepart}\\
		\vspace{0.5\baselineskip}
		\thispagestyle{empty}
		\centering\fsize{40}\textsc{#4}
	\end{center}%
}

