% Remapeos
\newcommand{\pars}[1]{\part{#1}\markboth{}{}\fancyhead[R]{\bfseries\thepart. #1}} % NO FER PARTS SEGUIDES SENSE CAPITOLS
\newcommand{\chap}[1]{\chapter{#1}\fancyhead[R]{\bf{\thechapter. \leftmark}}}

\newcommand{\chapless}[1]{\chapter*{#1}\fancyhead[R]{\bf{#1}}\addcontentsline{toc}{chapter}{#1}}
\newcommand{\sectionless}[1]{\section*{#1}\addcontentsline{toc}{section}{#1}}
\newcommand{\subsectionless}[1]{\subsection*{#1}}
\newcommand{\subsubsectionless}[1]{\subsubsection{#1}}
