% comandos para subsecciones alineados al contador unificado
\newcommand{\sublogicnum}[2]{%
\refstepcounter{defin}%
\subsubsection{#1\ \thedefin\ifstrempty{#2}{}{ (#2)}}%
}
\newcommand{\sublogicless}[2]{%
\subsubsection{#1\ifstrempty{#2}{}{ #2}}%
}

\newcommand{\subsectiondefin}[1][]{\sublogicnum{\nametheoremdefinition}{#1}}
\newcommand{\subsectiondefinless}[1][]{\sublogicless{\nametheoremdefinition}{#1}}
\newcommand{\subsectionques}[1][]{\sublogicnum{\nametheoremquestion}{#1}}
\newcommand{\subsectionquesless}[1][]{\sublogicless{\nametheoremquestion}{#1}}
\newcommand{\subsectionprob}[1][]{\sublogicnum{\nametheoremproblem}{#1}}
\newcommand{\subsectionprobless}[1][]{\sublogicless{\nametheoremproblem}{#1}}
\newcommand{\subsectionprop}[1][]{\sublogicnum{\nametheoremproposition}{#1}}
\newcommand{\subsectionpropless}[1][]{\sublogicless{\nametheoremproposition}{#1}}
\newcommand{\subsectionsol}[1][]{\sublogicnum{\nametheoremsolution}{#1}}
\newcommand{\subsectionsolless}[1][]{\sublogicless{\nametheoremsolution}{#1}}
\newcommand{\subsectioncoment}[1][]{\sublogicnum{\nametheoremcomment}{#1}}
\newcommand{\subsectioncomentless}[1][]{\sublogicless{\nametheoremcomment}{#1}}
\newcommand{\subsectionlem}[1][]{\sublogicnum{\nametheoremlemma}{#1}}
\newcommand{\subsectionlemless}[1][]{\sublogicless{\nametheoremlemma}{#1}}
\newcommand{\subsectionteo}[1][]{\sublogicnum{\nametheoremtheorem}{#1}}
\newcommand{\subsectionteoless}[1][]{\sublogicless{\nametheoremtheorem}{#1}}
\newcommand{\subsectioncor}[1][]{\sublogicnum{\nametheoremcorollary}{#1}}
\newcommand{\subsectioncorless}[1][]{\sublogicless{\nametheoremcorollary}{#1}}

