% Lógica de colocación automática de símbolo qed al final de los entornos
\makeatletter
% Cerrojos de seguridad
\newif\if@cuadroPuesto
\newif\if@in@theorem
\newif\if@just@started@thm

\newcommand{\qedsymbolshape}{$\blacksquare$}

% Función dibujadora (detecta entorno matemático o texto)
\newcommand{\ponercuadro}{%
	\if@cuadroPuesto\else
	\global\@cuadroPuestotrue
	\ifmmode
	\ifdefined\tag
	\tag*{\rlap{\hspace{0.6em}\qedsymbolshape}}%
	\else
	\eqno{\rlap{\hspace{0.6em}\qedsymbolshape}}%
	\fi
	\else
	\unskip\nobreak\hspace*{\fill}\rlap{\hspace{0.6em}\qedsymbolshape}%
	\fi
	\fi
}

% Intercepción de \] para colocar qed al final del modo Display
\let\old@enddisplay\]
\newcommand{\mi@enddisplay}{%
	\@ifnextchar\end{\ponercuadro\old@enddisplay}{\old@enddisplay}%
	}
	
	% Aplicación de qed relleno
	\newcommand{\addmarginqed}[1]{%
\AtBeginEnvironment{#1}{%
	\global\@in@theoremtrue
	\global\@cuadroPuestofalse
	\global\@just@started@thmtrue
	\everypar{\global\@just@started@thmfalse}%
	\def\qedsymbolshape{$\blacksquare$}%
	\let\]\mi@enddisplay
}%
\AtEndEnvironment{#1}{%
	\ponercuadro
	\global\@in@theoremfalse
}%
}

% Aplicación de qed hueco
\newcommand{\addmarginqedhollow}[1]{%
\AtBeginEnvironment{#1}{%
	\global\@in@theoremtrue
	\global\@cuadroPuestofalse
	\global\@just@started@thmtrue
	\everypar{\global\@just@started@thmfalse}%
	\def\qedsymbolshape{$\square$}%
	\let\]\mi@enddisplay
}%
\AtEndEnvironment{#1}{%
	\ponercuadro
	\global\@in@theoremfalse
}%
}


% Macro para entornos que NO llevan QED pero necesitan corregir la primera lista
\newcommand{\addlistfix}[1]{%
	\AtBeginEnvironment{#1}{%
		\global\@just@started@thmtrue
		\everypar{\global\@just@started@thmfalse}%
	}%
}

% Configuración de listas dentro de entornos (sin depender de \@in@theorem)
\newcommand{\@configurar@lista@teorema}{%
	\if@just@started@thm
	\leavevmode
	\global\@just@started@thmfalse
	\fi
}

% Hooks para enumerate e itemize
\AtBeginEnvironment{enumerate}{\@configurar@lista@teorema}
\AtBeginEnvironment{itemize}{\@configurar@lista@teorema}

\AtEndEnvironment{enumerate}{\if@in@theorem\ponercuadro\fi}
\AtEndEnvironment{itemize}{\if@in@theorem\ponercuadro\fi}

\makeatother

