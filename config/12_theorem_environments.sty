% Macro auxiliar: define automáticamente box<nombre>1 y box<nombre>2
\newcommand{\NewTheoremBox}[2]{%
	% Serie 1: Marco amarillo (Y1)
	\newtcolorbox{box#11}[1][]{%
		base frame overlay=Y1,%
		colframe=Y1,%
		code={\refstepcounter{defin}},%
		title={#2\ \thedefin\ifstrempty{##1}{}{ (##1)}}%
	}%
	% Serie 2: Marco dinámico según tema (\tcbTextColor)
	\newtcolorbox{box#12}[1][]{%
		base frame overlay=\tcbTextColor,%
		colframe=\tcbTextColor,%
		code={\refstepcounter{defin}},%
		title={#2\ \thedefin\ifstrempty{##1}{}{ (##1)}}%
	}%
}

