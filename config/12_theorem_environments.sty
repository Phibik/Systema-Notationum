% Definición de estilos de teoremas

% estilo 1: Triángulo sólido en el margen
\newtheoremstyle{TrianguloSolido}%
{15pt}{15pt}% espacio superior e inferior
{\normalfont}% fuente del cuerpo
{0pt}% indentación
{\bfseries}% fuente del título
{:}% puntuación
{.5em}% espacio tras puntuación
{\llap{\raisebox{0.15ex}{\small$\blacktriangleright$}\hspace{0.6em}}\thmname{#1}\thmnumber{ #2}\thmnote{ (#3)}}

% estilo 2: Triángulo hueco en el margen
\newtheoremstyle{TrianguloHueco}%
{15pt}{15pt}%
{\normalfont}%
{0pt}%
{\bfseries}{:}%
{.5em}%
{\llap{\raisebox{0.15ex}{\small$\vartriangleright$}\hspace{0.6em}}\thmname{#1}\thmnumber{ #2}\thmnote{ (#3)}}

% estilo 3: Rombo sólido en el margen
\newtheoremstyle{RomboSolido}%
{10pt}{10pt}% espacio vertical algo más ajustado
{\normalfont}%
{0pt}%
{\bfseries}%
{:}%
{.5em}%
{\llap{\raisebox{0.15ex}{\small$\blacklozenge$}\hspace{0.6em}}\thmname{#1}\thmnumber{ #2}\thmnote{ (#3)}}

% estilo 4: Rombo hueco en el margen
\newtheoremstyle{RomboHueco}%
{10pt}{10pt}%
{\normalfont}%
{0pt}%
{\bfseries}%
{:}%
{.5em}%
{\llap{\raisebox{0.15ex}{\small$\lozenge$}\hspace{0.6em}}\thmname{#1}\thmnumber{ #2}\thmnote{ (#3)}}

%====================================================%

% estilo 1: Triángulo sólido en el margen
\newtheoremstyle{TrianguloSolidoManual}%
{15pt}{15pt}% espacio superior e inferior
{\normalfont}% fuente del cuerpo
{0pt}% indentación
{\bfseries}% fuente del título
{}% puntuación vacía (se gestiona dinámicamente en la cabecera)
{.5em}% espacio tras puntuación
{%
	\llap{\raisebox{0.15ex}{\small$\blacktriangleright$}\hspace{0.6em}}%
	\ifstrempty{#1}{%
		\ifstrempty{#3}{}{#3:}% si no hay nombre (#1), imprime #3: solo si no está vacío
	}{%
		#1\ifstrempty{#3}{:}{ (#3):}% si hay nombre (#1), añade el colon o los paréntesis con colon
	}%
}

% estilo 2: Triángulo hueco en el margen
\newtheoremstyle{TrianguloHuecoManual}%
{15pt}{15pt}%
{\normalfont}%
{0pt}%
{\bfseries}%
{}%
{.5em}%
{%
	\llap{\raisebox{0.15ex}{\small$\vartriangleright$}\hspace{0.6em}}%
	\ifstrempty{#1}{%
		\ifstrempty{#3}{}{#3:}%
	}{%
		#1\ifstrempty{#3}{:}{ (#3):}%
	}%
}

% estilo 3: Rombo sólido en el margen
\newtheoremstyle{RomboSolidoManual}%
{10pt}{10pt}% espacio vertical algo más ajustado
{\normalfont}%
{0pt}%
{\bfseries}%
{}%
{.5em}%
{%
	\llap{\raisebox{0.15ex}{\small$\blacklozenge$}\hspace{0.6em}}%
	\ifstrempty{#1}{%
		\ifstrempty{#3}{}{#3:}%
	}{%
		#1\ifstrempty{#3}{:}{ (#3):}%
	}%
}

% estilo 4: Rombo hueco en el margen
\newtheoremstyle{RomboHuecoManual}%
{10pt}{10pt}%
{\normalfont}%
{0pt}%
{\bfseries}%
{}%
{.5em}%
{%
	\llap{\raisebox{0.15ex}{\small$\lozenge$}\hspace{0.6em}}%
	\ifstrempty{#1}{%
		\ifstrempty{#3}{}{#3:}%
	}{%
		#1\ifstrempty{#3}{:}{ (#3):}%
	}%
}

