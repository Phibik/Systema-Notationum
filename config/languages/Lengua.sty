% title page
\newcommand{\firstpage}[1]{
	\begin{titlepage}
		\newgeometry{top=115pt, bottom=100pt, right=100pt, left=100pt}
		\centering
		\begin{spacing}{3.75}
			\textsc{\fsize{#1pt}\titlename}
		\end{spacing}
		\vspace{-50pt}
		\rule{\textwidth}{2pt}\vspace*{-\baselineskip}\vspace{5pt} % Thin horizontal rule
		\rule{0.75\textwidth}{0.5pt} % Thick horizontal rule
		\vspace{0.75\baselineskip}\\
		{\Large Por\\}
		\vspace{0.5\baselineskip}
		\textsc{\huge\noindent \authorname}
		\vspace{1.5\baselineskip}\\
		\begin{tabular}{p{12cm}}
			\centering\textit{\large \subtitle}
		\end{tabular}
		\vfill
		\includegraphics[scale=0.025]{LOGO_blanc.png}\\
		\vspace{0.75\baselineskip}
		\textsl{\large Publicado en \pdate}
		\restoregeometry
	\end{titlepage}
}

